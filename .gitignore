# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/
# 只共享 SDK 路径和启动配置，其余个人设置不入库
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.packages
build/

# FVM：提交 fvm_config.json 锁定 Flutter 版本，忽略 SDK 软链接
!.fvm/
.fvm/flutter_sdk

# 旧版 xjj_app_base 代码的本地备份，不入库
.legacy-backup/
.upgrade-backup/

# Claude Code 本机权限配置（含个人绝对路径）
.claude/settings.local.json

# 本地环境配置（含密钥时不要提交）
env/*.local.json
.env*

# Flutter 生成文件
.flutter-plugins
.flutter-plugins-dependencies
